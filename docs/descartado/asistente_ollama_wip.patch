+def _post_stream(url: str, payload: dict, timeout: float = TIMEOUT_SEGUNDOS) -> Iterator[dict]:
+    """Como _post_json, pero para respuestas en streaming de Ollama: devuelve
+    cada objeto JSON (una linea por fragmento) a medida que llega."""
+    data = json.dumps(payload).encode("utf-8")
+    request = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"}, method="POST")
+    try:
+        with urllib.request.urlopen(request, timeout=timeout) as resp:
+            for linea in resp:
+                if not linea.strip():
+                    continue
+                chunk = json.loads(linea.decode("utf-8"))
+                if chunk.get("error"):
+                    raise AsistenteError(f"Ollama respondió con un error: {chunk['error']}")
+                yield chunk
+    except urllib.error.HTTPError as exc:
+        raise _error_http(exc) from exc
+    except urllib.error.URLError as exc:
+        raise AsistenteError(MENSAJE_SIN_CONEXION) from exc
+    except TimeoutError as exc:
+        raise AsistenteError(MENSAJE_TIMEOUT) from exc
+
+
+def _error_http(exc: urllib.error.HTTPError) -> AsistenteError:
+    cuerpo = exc.read().decode("utf-8", errors="ignore")
+    try:
+        mensaje = json.loads(cuerpo).get("error", cuerpo)
+    except json.JSONDecodeError:
+        mensaje = cuerpo
+    if exc.code == 404 and "not found" in mensaje:
+        return AsistenteError(f"El modelo configurado no está descargado en Ollama. Ejecutá en una terminal: ollama pull <nombre-del-modelo>. Detalle: {mensaje}")
+    return AsistenteError(f"Ollama respondió con un error: {mensaje}")
 
 
