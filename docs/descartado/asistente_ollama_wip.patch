+def test_responder_con_on_parcial_usa_streaming_y_acumula_fragmentos(conn):
+    llamadas = []
+    parciales = []
+
+    def post_stream_fake(url, payload):
+        llamadas.append((url, payload))
+        yield {"message": {"content": "Gastaste "}}
+        yield {"message": {"content": "$15.000"}}
+        yield {"message": {"content": ""}, "done": True}
+
+    def post_json_prohibido(url, payload):
+        raise AssertionError("con on_parcial no deberia usarse la llamada sin streaming")
+
+    service = AsistenteIAService(ConfigService(conn), post_json=post_json_prohibido, post_stream=post_stream_fake)
+
+    respuesta = service.responder("¿cuánto gasté?", "contexto", on_parcial=parciales.append)
+
+    assert respuesta == "Gastaste $15.000"
+    assert parciales == ["Gastaste ", "Gastaste $15.000"]
+    url, payload = llamadas[0]
+    assert url == "http://localhost:11434/api/chat"
+    assert payload["stream"] is True
+
+
